{
  "manifest_version": 3,
  "name": "Anti Procrastionation Extension (YouTube)",
  "version": "1.0.0",
  "permissions": ["tabs"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "web_accessible_resources": [{
    "resources": ["blocked.html"],
    "matches": ["*://*.youtube.com/*"]
  }],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
